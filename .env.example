# =============================================================================
# Postora — Self-Hosted Supabase Environment (placeholders only)
# =============================================================================
# Canonical Supabase host: https://api.postora.cloud  (Kong gateway on VPS)
# App origin (production):  https://postora.cloud
#
# Fill in real values locally. NEVER commit real secrets.
#
# *** CRITICAL — EDGE FUNCTIONS INJECTION WARNING ***
# Filling in this file is NOT enough. Supabase Edge Runtime functions run inside
# a Docker container whose env is controlled by docker-compose.yml. Docker Compose
# .env only does ${VAR} interpolation INTO the compose file — it does NOT inject
# every variable into containers automatically. Every variable below MUST also be
# declared under the `functions` service `env_file: [./.env]` (preferred) or be
# explicitly mapped in its `environment:` block. Without that, Deno.env.get()
# returns undefined and functions fail with "secret not configured". See
# docs/EDGE_RUNTIME_ENV_RUNBOOK.md and infra/edge-runtime.required-env.json.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — frontend (Vite-exposed)
# -----------------------------------------------------------------------------
# NOTE: VITE_SUPABASE_PUBLISHABLE_KEY and VITE_SUPABASE_ANON_KEY MUST hold the
# SAME self-hosted anon/publishable JWT. Both names exist for naming
# compatibility until the codebase standardizes on one variable.
VITE_SUPABASE_URL=https://api.postora.cloud
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
# Optional. Override only if the self-hosted Studio is served from a
# different host than the API gateway. Leave blank to hide the Studio link.
VITE_SUPABASE_STUDIO_URL=https://api.postora.cloud
# Cosmetic compatibility only — NEVER used to construct URLs.
VITE_SUPABASE_PROJECT_ID=self-hosted

# Deployment origins
PUBLIC_APP_ORIGIN=https://postora.cloud
PUBLIC_API_ORIGIN=https://api.postora.cloud

# -----------------------------------------------------------------------------
# Supabase — server / Edge Functions
# -----------------------------------------------------------------------------
SUPABASE_URL=https://api.postora.cloud
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# HMAC pepper for MFA backup codes. Generate a high-entropy secret and keep it
# only in server-side Edge Runtime environment variables.
BACKUP_CODE_PEPPER=
SUPABASE_JWT_SECRET=
DATABASE_URL=
SUPABASE_DB_URL=
# Public app origin used by functions for OAuth redirects/callbacks.
# Alias of PUBLIC_APP_ORIGIN above. Set at least one of the two.
SITE_URL=https://postora.cloud
# Optional: cloud-style Management API token. Leave blank on self-hosted.
SB_MANAGEMENT_TOKEN=
SUPABASE_PROJECT_REF=self-hosted

# Shared secret for cron-triggered Edge Functions. Required.
# Generate a strong random value (>= 32 chars) and store it ONLY in the
# production .env on the VPS. pg_cron jobs must send it as either
#   Authorization: Bearer <CRON_SECRET>
# or
#   x-cron-secret: <CRON_SECRET>
# Verified by supabase/functions/_shared/cron-auth.ts.
CRON_SECRET=



# -----------------------------------------------------------------------------
