# =============================================================================
# Postora — Self-Hosted Supabase Environment (placeholders only)
# =============================================================================
# Canonical Supabase host: https://api.postora.cloud  (Kong gateway on VPS)
# App origin (production):  https://postora.cloud
#
# Fill in real values locally. NEVER commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — frontend (Vite-exposed)
# -----------------------------------------------------------------------------
# NOTE: VITE_SUPABASE_PUBLISHABLE_KEY and VITE_SUPABASE_ANON_KEY MUST hold the
# SAME self-hosted anon/publishable JWT. Both names exist for naming
# compatibility until the codebase standardizes on one variable.
VITE_SUPABASE_URL=https://api.postora.cloud
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
# Optional. Override only if the self-hosted Studio is served from a
# different host than the API gateway. Leave blank to hide the Studio link.
VITE_SUPABASE_STUDIO_URL=https://api.postora.cloud
# Cosmetic compatibility only — NEVER used to construct URLs.
VITE_SUPABASE_PROJECT_ID=self-hosted

# Deployment origins
PUBLIC_APP_ORIGIN=https://postora.cloud
PUBLIC_API_ORIGIN=https://api.postora.cloud

# -----------------------------------------------------------------------------
# Supabase — server / Edge Functions
# -----------------------------------------------------------------------------
SUPABASE_URL=https://api.postora.cloud
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=
SUPABASE_DB_URL=
# Optional: cloud-style Management API token. Leave blank on self-hosted.
SB_MANAGEMENT_TOKEN=
SUPABASE_PROJECT_REF=self-hosted

# -----------------------------------------------------------------------------
# Meta — Facebook / Instagram / Threads
# -----------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://api.postora.cloud/functions/v1/instagram-oauth
INSTAGRAM_BUSINESS_REDIRECT_URI=https://api.postora.cloud/functions/v1/instagram-business-oauth
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_DEMO_MODE=false
THREADS_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v22.0

# -----------------------------------------------------------------------------
# Google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AI_STUDIO_KEY=

# -----------------------------------------------------------------------------
# TikTok
# -----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Twitter / X  (X_API_* are kept as aliases for legacy code; same value as X_CLIENT_*)
# -----------------------------------------------------------------------------
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=

# -----------------------------------------------------------------------------
# LinkedIn
# -----------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api.postora.cloud/functions/v1/linkedin-oauth

# -----------------------------------------------------------------------------
# Pinterest
# -----------------------------------------------------------------------------
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# WhatsApp Cloud API
# -----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_PIN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# -----------------------------------------------------------------------------
# Slack
# -----------------------------------------------------------------------------
SLACK_API_KEY=

# -----------------------------------------------------------------------------
# AI providers
