# Shell scripts must stay LF. scripts/deploy/postora-edge-deploy.sh is executed by
# bash on the Contabo VPS, and a CRLF shebang line fails with "bad interpreter".
# core.autocrlf=true on Windows checkouts would otherwise hand out CRLF copies.
*.sh text eol=lf
# SQL must stay LF too. A core.autocrlf=true checkout hands out CRLF .sql copies,
# and the SQL test suite failed its baseline on such a copy (2026-11-04).
*.sql text eol=lf
supabase/functions/_shared/vendor/tslib-2.8.1.mjs -text
supabase/functions/_shared/vendor/tslib-2.8.1.LICENSE.txt -text
